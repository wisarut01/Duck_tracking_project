{
  "name": "tracking-board-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:msw": "VITE_MSW=true vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "npx -y openapi-typescript@7.13.0 ../api/openapi.yaml -o src/types/openapi.gen.ts",
    "check:api": "npx -y openapi-typescript@7.13.0 ../api/openapi.yaml -o src/types/openapi.gen.ts --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.3",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
